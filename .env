# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_ALLOWED_USER_IDS=REPLACE_ME

# === RPC (Ethereum mainnet) ===
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/REPLACE_ME

# === SeaDrop canonical (kontrak mint) ===
CONTRACT_ADDRESS=0x00005EA00Ac477B1030CE78506496e8C2dE24bf5

# === Fungsi mint FCFS/Public (SeaDrop) ===
MINT_SIG=mintPublic(address,address,address,uint256)
ABI_OVERRIDE=["function mintPublic(address,address,address,uint256) payable"]
FUNCTION_ARGS_JSON=["NFT_CONTRACT","FEE_RECIPIENT","WALLET","AMOUNT"]

# === Project Merlin NFT & fee recipient (conduit OpenSea) ===
NFT_CONTRACT=0x120f79BfAFEb647bde171630B06b926ac4C35ceD
FEE_RECIPIENT=0x0000a26b00c1F0DF003000390027140000fAa719

# === Parameter Mint ===
MINT_AMOUNT=1
MINT_PRICE=0  # Free mint

# === Mode multi wallet ===
MODE=multi
# PRIVATE_KEYS sekarang dibaca dari pk.txt

# === FCFS settings ===
WAIT_FOR=sent
CONCURRENCY=3
GAS_LIMIT=300000

# === Gas (EIP-1559) ===
# Biarkan kosong untuk menggunakan fee otomatis +15%
MAX_FEE_GWEI=
MAX_PRIORITY_GWEI=

# === Retry ===
RETRY_ATTEMPTS=3
RETRY_BACKOFF_MS=500
GAS_BUMP_PERCENT=20

# === Branding (opsional) ===
BRAND_ADMIN_HANDLE=@nolxnode
BRAND_CHANNEL_NAME=Airdrop Node
BRAND_CHANNEL_URL=https://t.me/airdrop_node
