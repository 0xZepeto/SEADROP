# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# === SeaDrop canonical (kontrak mint) ===
CONTRACT_ADDRESS=0x00005EA00Ac477B1030CE78506496e8C2dE24bf5

# === Fungsi mint FCFS/Public (SeaDrop) ===
MINT_SIG=mintPublic(address,address,address,uint256)
ABI_OVERRIDE=["function mintPublic(address,address,address,uint256) payable"]
FUNCTION_ARGS_JSON=["NFT_CONTRACT","FEE_RECIPIENT","WALLET","AMOUNT"]

# === fee recipient (conduit OpenSea) ===
FEE_RECIPIENT=0x0000a26b00c1F0DF003000390027140000fAa719

# === Param mint (max mint) ===
MINT_AMOUNT=1  # Max mint
MINT_PRICE=0  # Harga per NFT

# === Mode multi wallet ===
MODE=multi

# === FCFS settings ===
WAIT_FOR=sent
CONCURRENCY=1  # Kurangi untuk menghindari error
TX_DELAY_MS=2000  # Tambah jeda 2 detik antar wallet
GAS_LIMIT=350000  # Dikurangi untuk hemat gas

# === Gas (EIP-1559) - Ditingkatkan untuk mengatasi replacement fee ===
MAX_FEE_GWEI=0.01
MAX_PRIORITY_GWEI=0.002

# === Retry ===
RETRY_ATTEMPTS=1
RETRY_BACKOFF_MS=0
GAS_BUMP_PERCENT=0

# === Branding (opsional) ===
BRAND_ADMIN_HANDLE=@🔥
BRAND_CHANNEL_NAME=@🔥
BRAND_CHANNEL_URL=👑
